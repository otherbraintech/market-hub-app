// Plataforma de Marketing Event-Driven
// Schema Prisma - Base de datos PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

// ============================================
// EVENTOS Y JOBS (Sistema Event-Driven)
// ============================================

model Event {
  id        String    @id @default(cuid())
  type      EventType
  payload   Json
  metadata  Json? // contexto adicional
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id])
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([jobId])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  payload     Json
  result      Json?
  error       String?
  retries     Int       @default(0)
  maxRetries  Int       @default(3)
  webhookUrl  String? // URL del webhook destino
  callbackUrl String? // URL para callback de respuesta
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events    Event[]
  auditLogs AuditLog[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum EventType {
  // Generación de contenido
  GENERATE_CONTENT_IDEAS
  GENERATE_COPY
  GENERATE_MEDIA
  REGENERATE_MEDIA

  // Publicación
  PUBLISH_CONTENT
  SCHEDULE_CONTENT

  // Métricas
  FETCH_METRICS

  // Sistema
  JOB_CREATED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED

  // Negocio
  BUSINESS_CREATED
  BUSINESS_UPDATED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CONTENT_CREATED
  CONTENT_UPDATED
}

enum JobType {
  GENERATE_CONTENT_IDEAS
  GENERATE_COPY
  GENERATE_MEDIA
  REGENERATE_MEDIA
  PUBLISH_CONTENT
  FETCH_METRICS
  ANALYZE_CAMPAIGN
  SYNC_SOCIAL_ACCOUNTS
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

// ============================================
// AUDITORÍA
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // Business, Campaign, Content, etc.
  entityId   String
  action     String // CREATE, UPDATE, DELETE
  changes    Json? // diff de cambios
  userId     String?
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// NEGOCIO Y MARCA
// ============================================

model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  industry    String?
  website     String?
  logo        String?

  // Identidad de marca
  brandVoice  Json? // tono, personalidad, valores
  brandColors Json? // colores primarios/secundarios
  brandFonts  Json?

  // Audiencia
  targetAudience Json?

  // Configuración
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  strategies     MarketingStrategy[]
  products       Product[]
  campaigns      Campaign[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]

  @@index([slug])
}

// ============================================
// ESTRATEGIA DE MARKETING
// ============================================

model MarketingStrategy {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)

  // Objetivos SMART
  objectives Json // array de objetivos con métricas

  // Buyer Personas
  personas Json // array de personas con demografía, pain points, goals

  // Funnel de ventas
  funnelStages Json // awareness, consideration, decision, retention

  // Canales
  channels Json // redes sociales, email, paid, etc.

  // Líneas de contenido
  contentPillars Json? // temas principales para el contenido

  // Calendario básico
  postingSchedule Json? // frecuencia por canal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([businessId])
}

// ============================================
// PRODUCTOS
// ============================================

model Product {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String
  shortDesc   String? // descripción corta para ads

  // Características y beneficios
  features Json // array de características
  benefits Json // array de beneficios (para marketing)

  // Precios
  pricing Json? // estructura de precios

  // Media
  images Json? // URLs de imágenes

  // SEO y keywords
  keywords Json? // palabras clave para contenido

  // Estado
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  contents Content[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ============================================
// CAMPAÑAS
// ============================================

model Campaign {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  strategyId String?
  strategy   MarketingStrategy? @relation(fields: [strategyId], references: [id])

  name        String
  slug        String
  description String?

  // Objetivo de la campaña
  objective        CampaignObjective
  objectiveDetails Json? // métricas específicas

  // Fechas
  startDate DateTime
  endDate   DateTime?

  // Estado
  status CampaignStatus @default(DRAFT)

  // Configuración
  budget    Decimal? @db.Money
  channels  Json // canales activos para esta campaña
  targeting Json? // segmentación

  // Resultados
  metrics Json? // métricas agregadas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  contents Content[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([status])
  @@index([startDate, endDate])
}

enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  TRAFFIC
  LEADS
  SALES
  RETENTION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================
// CONTENIDO
// ============================================

model Content {
  id String @id @default(cuid())

  // Relaciones
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])

  // Tipo y formato
  type   ContentType
  format ContentFormat?

  // Contenido
  title    String
  body     String? @db.Text
  caption  String? @db.Text // para redes sociales
  hashtags Json? // array de hashtags

  // Media
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  mediaUrl     String? // URL directa (legacy)
  thumbnailUrl String?

  // Metadatos
  metadata Json? // datos adicionales según tipo

  // Estado
  status ContentStatus @default(IDEA)

  // Programación
  scheduledAt DateTime?
  publishedAt DateTime?

  // Canal destino
  channel         SocialChannel?
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])

  // Generación IA
  generatedByJobId String? // Job que lo generó
  promptUsed       String? @db.Text
  aiMetadata       Json? // modelo usado, tokens, etc.

  // Resultados
  metrics     Json? // engagement, reach, etc.
  externalId  String? // ID en la plataforma externa
  externalUrl String? // URL en la plataforma

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@index([channel])
}

enum ContentType {
  POST
  STORY
  REEL
  VIDEO
  CAROUSEL
  ARTICLE
  BLOG
  EMAIL
  AD
  TWEET
  THREAD
}

enum ContentFormat {
  IMAGE
  VIDEO
  TEXT
  LINK
  POLL
  LIVE
}

enum ContentStatus {
  IDEA
  DRAFT
  GENERATING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum SocialChannel {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
}

// ============================================
// CUENTAS SOCIALES
// ============================================

model SocialAccount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channel     SocialChannel
  accountId   String // ID en la plataforma
  accountName String
  accountUrl  String?
  avatar      String?

  // Autenticación (encriptada)
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?

  // Estado
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?

  // Métricas
  followers Int?
  metrics   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  contents Content[]

  @@unique([businessId, channel, accountId])
  @@index([businessId])
}

// ============================================
// MEDIA ASSETS
// ============================================

model MediaAsset {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Tipo
  type MediaType

  // Archivo
  filename     String
  url          String
  thumbnailUrl String?
  mimeType     String
  size         Int // bytes

  // Dimensiones (para imágenes/videos)
  width    Int?
  height   Int?
  duration Int? // segundos, para videos/audio

  // Metadatos
  alt      String? // texto alternativo
  caption  String?
  metadata Json? // EXIF, etc.

  // Generación IA
  generatedByJobId String?
  promptUsed       String? @db.Text

  // Organización
  folder String?
  tags   Json? // array de tags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  contents Content[]

  @@index([businessId])
  @@index([type])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  GIF
}

// ============================================
// CONFIGURACIÓN DE WEBHOOKS
// ============================================

model WebhookConfig {
  id String @id @default(cuid())

  name        String
  description String?

  // Tipo de evento que dispara
  eventType EventType

  // Destino
  url     String
  method  String @default("POST")
  headers Json? // headers adicionales

  // Autenticación
  secret    String? // para firmar requests
  authType  String? // bearer, basic, hmac
  authValue String? // token o credenciales

  // Configuración
  isActive    Boolean @default(true)
  retryPolicy Json? // política de reintentos
  timeout     Int     @default(30000) // ms

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([isActive])
}

// ============================================
// CONFIGURACIÓN DE PROMPTS
// ============================================

model PromptTemplate {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  category    String // content_ideas, copy, media, etc.

  // Template con variables {{variable}}
  template String @db.Text

  // Variables esperadas
  variables Json // array de {name, type, required, description}

  // Configuración del modelo
  modelConfig Json? // temperature, max_tokens, etc.

  // Versioning
  version  Int     @default(1)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String // Hash
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
