generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  payload   Json
  metadata  Json?
  jobId     String?
  createdAt DateTime  @default(now())
  job       Job?      @relation(fields: [jobId], references: [id])

  @@index([type])
  @@index([jobId])
  @@index([createdAt])
}

model Job {
  id          String     @id @default(cuid())
  type        JobType                
  status      JobStatus  @default(PENDING)
  priority    Int        @default(0)
  payload     Json
  result      Json?
  error       String?
  retries     Int        @default(0)
  maxRetries  Int        @default(3)
  webhookUrl  String?
  callbackUrl String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
  events      Event[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  changes    Json?
  userId     String?
  jobId      String?
  createdAt  DateTime @default(now())
  job        Job?     @relation(fields: [jobId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Business {
  id                                 String              @id @default(cuid())
  name                               String
  slug                               String              @unique
  description                        String?
  industry                           String?
  website                            String?
  logo                               String?
  brandVoice                         Json?
  brandColors                        Json?
  brandFonts                         Json?
  targetAudience                     Json?
  createdAt                          DateTime            @default(now())
  updatedAt                          DateTime            @updatedAt
  phoneNumbers                       String?
  socialLinks                        Json?
  userId                             String?
  location                           String?
  branches                           Json?
  catalog                            Json?
  settings                           Json?
  competitorGeneralReport            Json?
  competitorGeneralReportGeneratedAt DateTime?
  onboardingStrategy                 Json?
  agentNotifications                 AgentNotification[]
  user                               User?               @relation(fields: [userId], references: [id])
  campaigns                          Campaign[]
  competitors                        Competitor[]
  strategies                         MarketingStrategy[]
  mediaAssets                        MediaAsset[]
  products                           Product[]
  socialAccounts                     SocialAccount[]

  @@index([slug])
}

model MarketingStrategy {
  id              String     @id @default(cuid())
  businessId      String
  name            String
  description     String?
  isActive        Boolean    @default(true)
  objectives      Json
  personas        Json
  funnelStages    Json
  channels        Json
  contentPillars  Json?
  postingSchedule Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  campaigns       Campaign[]
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Product {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  slug        String
  description String
  shortDesc   String?
  features    Json
  benefits    Json
  pricing     Json?
  images      Json?
  keywords    Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contents    Content[]
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
}

model Campaign {
  id               String             @id @default(cuid())
  businessId       String
  strategyId       String?
  name             String
  slug             String
  description      String?
  objective        CampaignObjective
  objectiveDetails Json?
  startDate        DateTime
  endDate          DateTime?
  status           CampaignStatus     @default(DRAFT)
  budget           Decimal?           @db.Money
  channels         Json
  targeting        Json?
  metrics          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  strategy         MarketingStrategy? @relation(fields: [strategyId], references: [id])
  contents         Content[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([status])
  @@index([startDate, endDate])
}

model Content {
  id               String         @id @default(cuid())
  campaignId       String?
  productId        String?
  type             ContentType
  format           ContentFormat?
  title            String
  body             String?
  caption          String?
  hashtags         Json?
  mediaAssetId     String?
  mediaUrl         String?
  thumbnailUrl     String?
  metadata         Json?
  status           ContentStatus  @default(IDEA)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  channel          SocialChannel?
  socialAccountId  String?
  generatedByJobId String?
  promptUsed       String?
  aiMetadata       Json?
  metrics          Json?
  externalId       String?
  externalUrl      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  campaign         Campaign?      @relation(fields: [campaignId], references: [id])
  mediaAsset       MediaAsset?    @relation(fields: [mediaAssetId], references: [id])
  product          Product?       @relation(fields: [productId], references: [id])
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id])

  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@index([channel])
}

model SocialAccount {
  id           String        @id @default(cuid())
  businessId   String
  channel      SocialChannel
  accountId    String
  accountName  String
  accountUrl   String?
  avatar       String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  isActive     Boolean       @default(true)
  lastSyncAt   DateTime?
  followers    Int?
  metrics      Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contents     Content[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel, accountId])
  @@index([businessId])
}

model MediaAsset {
  id               String    @id @default(cuid())
  businessId       String
  type             MediaType
  filename         String
  url              String
  thumbnailUrl     String?
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  duration         Int?
  alt              String?
  caption          String?
  metadata         Json?
  generatedByJobId String?
  promptUsed       String?
  folder           String?
  category         String?
  formatCategory   String?
  tags             Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contents         Content[]
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
}

model WebhookConfig {
  id          String    @id @default(cuid())
  name        String
  description String?
  eventType   EventType
  url         String
  method      String    @default("POST")
  headers     Json?
  secret      String?
  authType    String?
  authValue   String?
  isActive    Boolean   @default(true)
  retryPolicy Json?
  timeout     Int       @default(30000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventType])
  @@index([isActive])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  template    String
  variables   Json
  modelConfig Json?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model User {
  id             String     @id @default(cuid())
  username       String     @unique
  name           String
  password       String
  role           String     @default("USER")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  maxBusinesses  Int        @default(1)
  maxCompetitors Int        @default(3)
  businesses     Business[]
}

model Competitor {
  id         String   @id @default(cuid())
  businessId String
  name       String?
  website    String?
  facebook   String?
  instagram  String?
  tiktok     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  linkedin   String?
  seoGoogle  String?
  youtube    String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AnalysisReport {
  id          String    @id @default(cuid())
  entityId    String
  url         String
  data        Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?
  updatedAt   DateTime  @updatedAt
  type        String
  status      String
  channel     String    @default("WEBSITE")

  @@index([type, entityId, channel])
  @@index([status])
}

model AgentNotification {
  id         String   @id @default(cuid())
  businessId String
  title      String
  message    String
  step       String
  status     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum EventType {
  GENERATE_CONTENT_IDEAS
  GENERATE_COPY
  GENERATE_MEDIA
  REGENERATE_MEDIA
  PUBLISH_CONTENT
  SCHEDULE_CONTENT
  FETCH_METRICS
  JOB_CREATED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  BUSINESS_CREATED
  BUSINESS_UPDATED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CONTENT_CREATED
  CONTENT_UPDATED
}

enum JobType {
  GENERATE_CONTENT_IDEAS
  GENERATE_COPY
  GENERATE_MEDIA
  REGENERATE_MEDIA
  PUBLISH_CONTENT
  FETCH_METRICS
  ANALYZE_CAMPAIGN
  SYNC_SOCIAL_ACCOUNTS
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  TRAFFIC
  LEADS
  SALES
  RETENTION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ContentType {
  POST
  STORY
  REEL
  VIDEO
  CAROUSEL
  ARTICLE
  BLOG
  EMAIL
  AD
  TWEET
  THREAD
}

enum ContentFormat {
  IMAGE
  VIDEO
  TEXT
  LINK
  POLL
  LIVE
}

enum ContentStatus {
  IDEA
  DRAFT
  GENERATING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum SocialChannel {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  GIF
}

enum CivicDateCategory {
  CIVICA
  COMERCIAL
  RELIGIOSA
  CULTURAL
  REGIONAL
  INTERNACIONAL
}

model CivicDate {
  id          String            @id @default(cuid())
  name        String
  date        String            // "MM-DD" for recurring, or "YYYY-MM-DD" for fixed
  fixedYear   Int?              // null = recurring annual, 2026 = only that year
  category    CivicDateCategory
  region      String            @default("BOLIVIA")
  description String?
  importance  Int               @default(5) // 1-10
  hashtags    Json?
  industries  Json?             // null = all industries
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([category])
  @@index([region])
}
